    end

    function window:SelectTab(name)
        for tabName, tab in pairs(self.Tabs) do
            local active = tabName == name
            tab.Page.Visible = active
            tab.Indicator.Visible = active
            tab.Button.TextColor3 = active and theme.Text or theme.TextDark
            tab.Button.BackgroundTransparency = active and 0 or 1
            if active then self.CurrentTab = name end
        end
    end

    function window:CreateTabSection(name)
