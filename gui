            s:AddButton("Unload UI", function() self:Destroy() end)
        end
        self:SelectTab(self.CurrentTab or "Settings")
        return self
    end

    function window:Destroy()
        if self._destroyed then return end
        self._destroyed=true; self.IsOpen=false; Arcane.IsOpen=false
        if self.Gui then self.Gui:Destroy() end
    end

    return window
