local function themeCopy(t)
    local out = {}
    for k, v in pairs(t) do out[k] = v end
    return out
end

function Arcane:AddTheme(name, config)
    themes[name] = config
end

local function new(className, props, parent)
    local obj = Instance.new(className)
    for k, v in pairs(props or {}) do obj[k] = v end
    if parent then obj.Parent = parent end
    return obj
end

local function corner(obj, radius)
    return new("UICorner", {CornerRadius = UDim.new(0, radius or 6)}, obj)
end

local function stroke(obj, color, thickness, transparency)
    return new("UIStroke", {
        Color = color,
        Thickness = thickness or 1,
        Transparency = transparency or 0,
    }, obj)
end

local function makeText(parent, text, size, color, font)
    return new("TextLabel", {
        BackgroundTransparency = 1,
        Text = text or "",
        TextColor3 = color,
        TextSize = size or 14,
        Font = font or Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        Size = UDim2.new(1, 0, 0, 22),
    }, parent)
end

local function bindHover(button, normal, hover)
    button.MouseEnter:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.12), {BackgroundColor3 = hover}):Play()
    end)
    button.MouseLeave:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.12), {BackgroundColor3 = normal}):Play()
    end)
end

local function callbackSafe(fn, ...)
    if type(fn) ~= "function" then return end
    task.spawn(function()
        local ok, err = pcall(fn, ...)
        if not ok then warn("[Arcane callback]", err) end
    end)
end

local function resolveSize(size)
    if typeof(size) == "Vector2" then
        return UDim2.fromOffset(size.X, size.Y)
    end
    if typeof(size) == "UDim2" then return size end
    return UDim2.fromOffset(700, 480)
end

local function normalizeOptions(options)
    options = options or {}
    return {
        Min = options.Min or 0,
        Max = options.Max or 100,
        Default = options.Default ~= nil and options.Default or options.Min or 0,
        Callback = options.Callback,
    }
end

function Arcane:Notify(title, text, duration)
    duration = duration or 5
    local theme = themes.Default
    local gui = self._notificationGui
    if not gui then
        gui = new("ScreenGui", {
            Name = "ArcaneNotifications",
            ResetOnSpawn = false,
            IgnoreGuiInset = true,
            ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        }, PlayerGui)
        self._notificationGui = gui
    end

    local holder = gui:FindFirstChild("Holder")
    if not holder then
        holder = new("Frame", {
            Name = "Holder",
            BackgroundTransparency = 1,
            AnchorPoint = Vector2.new(1, 1),
            Position = UDim2.new(1, -18, 1, -18),
            Size = UDim2.fromOffset(310, 500),
        }, gui)
        new("UIListLayout", {FillDirection = Enum.FillDirection.Vertical, HorizontalAlignment = Enum.HorizontalAlignment.Right, VerticalAlignment = Enum.VerticalAlignment.Bottom, Padding = UDim.new(0, 8)}, holder)
    end

    local card = new("Frame", {
        BackgroundColor3 = theme.Background,
        Size = UDim2.fromOffset(300, 68),
        BackgroundTransparency = 1,
    }, holder)
    corner(card, 7); stroke(card, theme.Accent, 1, 0.15)
    local bar = new("Frame", {BackgroundColor3 = theme.Accent, BorderSizePixel = 0, Size = UDim2.new(0, 3, 1, 0)}, card)
    corner(bar, 7)
    local titleLabel = makeText(card, title or "Arcane", 14, theme.Accent, Enum.Font.GothamBold)
    titleLabel.Position = UDim2.fromOffset(14, 5); titleLabel.Size = UDim2.new(1, -20, 0, 22)
    local body = makeText(card, text or "", 12, theme.Text, Enum.Font.Gotham)
    body.Position = UDim2.fromOffset(14, 28); body.Size = UDim2.new(1, -20, 0, 34); body.TextWrapped = true
    local progress = new("Frame", {BackgroundColor3 = theme.Accent, BorderSizePixel = 0, Position = UDim2.new(0, 10, 1, -5), Size = UDim2.new(1, -20, 0, 2)}, card)
    corner(progress, 2)

    TweenService:Create(card, TweenInfo.new(0.2), {BackgroundTransparency = 0}):Play()
    TweenService:Create(progress, TweenInfo.new(duration, Enum.EasingStyle.Linear), {Size = UDim2.new(0, 0, 0, 2)}):Play()
    task.delay(duration, function()
        if card.Parent then
            TweenService:Create(card, TweenInfo.new(0.2), {BackgroundTransparency = 1}):Play()
            task.wait(0.21)
            card:Destroy()
        end
    end)
end

function Arcane:Log(text, duration)
    self:Notify("Log", text, duration or 4)
end

