        corner(indicator, 2)
        tab.Button = button
        tab.Indicator = indicator

        local page = new("ScrollingFrame", {
            Name = name .. "Page",
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Size = UDim2.new(1, -24, 1, -24),
