            corner(box, 5); stroke(box, theme.Outline, 1, 0.25); new("UIPadding", {PaddingLeft = UDim.new(0, 9)}, box)
            box.FocusLost:Connect(function() callbackSafe(callback, box.Text) end)
            return addControl(holder, 50) and {Value = default or "", Box = box, GetValue = function() return box.Text end, SetValue = function(_, v) box.Text = tostring(v); callbackSafe(callback, box.Text) end}
        end
        section.AddTextbox = section.AddTextBox

        function section:AddSlider(text, options)
            options = normalizeOptions(options)
            local holder = new("Frame", {BackgroundTransparency = 1}, body)
            local label = makeText(holder, text, 12, theme.Text, Enum.Font.GothamMedium)
            label.Size = UDim2.new(1, -55, 0, 18)
            local valueLabel = makeText(holder, tostring(options.Default), 12, theme.Accent, Enum.Font.GothamBold)
            valueLabel.Position = UDim2.new(1, -55, 0, 0); valueLabel.Size = UDim2.fromOffset(55, 18); valueLabel.TextXAlignment = Enum.TextXAlignment.Right
            local bar = new("Frame", {BackgroundColor3 = theme.Button, BorderSizePixel = 0, Position = UDim2.fromOffset(0, 23), Size = UDim2.new(1, 0, 0, 8)}, holder); corner(bar, 4)
            local fill = new("Frame", {BackgroundColor3 = theme.Accent, BorderSizePixel = 0, Size = UDim2.new(0, 0, 1, 0)}, bar); corner(fill, 4)
            local slider = {Value = options.Default, Min = options.Min, Max = options.Max, Callback = options.Callback}
            local function set(v, fire)
                v = math.clamp(v, slider.Min, slider.Max); slider.Value = v
                local p = (v - slider.Min) / math.max(slider.Max - slider.Min, 1e-6)
                fill.Size = UDim2.new(p, 0, 1, 0); valueLabel.Text = tostring(math.floor(v*100+0.5)/100)
                if fire then callbackSafe(slider.Callback, v) end
            end
            function slider:SetValue(v) set(v, true) end
            function slider:GetValue() return slider.Value end
            local dragging = false
            bar.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true; set(slider.Min + (slider.Max-slider.Min)*((i.Position.X-bar.AbsolutePosition.X)/bar.AbsoluteSize.X), true) end end)
            UserInputService.InputChanged:Connect(function(i) if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then set(slider.Min + (slider.Max-slider.Min)*((i.Position.X-bar.AbsolutePosition.X)/bar.AbsoluteSize.X), true) end end)
            UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end end)
            set(options.Default, false)
            addControl(holder, 43); return slider
        end

        function section:AddDualSlider(text, options)
            options = options or {}; local minV, maxV = options.Min or 0, options.Max or 100
            local low, high = options.DefaultLow or minV, options.DefaultHigh or maxV
            local holder = new("Frame", {BackgroundTransparency = 1}, body)
            local label = makeText(holder, text, 12, theme.Text, Enum.Font.GothamMedium); label.Size = UDim2.new(1, -70, 0, 18)
            local valueLabel = makeText(holder, "", 12, theme.Accent, Enum.Font.GothamBold); valueLabel.Position = UDim2.new(1,-70,0,0); valueLabel.Size = UDim2.fromOffset(70,18); valueLabel.TextXAlignment = Enum.TextXAlignment.Right
            local bar = new("Frame", {BackgroundColor3 = theme.Button, BorderSizePixel = 0, Position = UDim2.fromOffset(0,23), Size = UDim2.new(1,0,0,8)}, holder); corner(bar,4)
            local fill = new("Frame", {BackgroundColor3 = theme.Accent, BorderSizePixel=0}, bar); corner(fill,4)
            local slider = {Low=low, High=high, Min=minV, Max=maxV, Callback=options.Callback}
            local function update(fire)
                slider.Low = math.clamp(math.min(slider.Low, slider.High),minV,maxV); slider.High=math.clamp(math.max(slider.Low,slider.High),minV,maxV)
                local a=(slider.Low-minV)/math.max(maxV-minV,1e-6); local b=(slider.High-minV)/math.max(maxV-minV,1e-6)
                fill.Position=UDim2.new(a,0,0,0); fill.Size=UDim2.new(b-a,0,1,0); valueLabel.Text=tostring(math.floor(slider.Low)).." - "..tostring(math.floor(slider.High))
                if fire then callbackSafe(slider.Callback, slider.Low, slider.High) end
            end
            function slider:SetValues(a,b) slider.Low=a; slider.High=b; update(true) end
            function slider:GetValues() return slider.Low, slider.High end
            local dragging = nil
            bar.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then local p=math.clamp((i.Position.X-bar.AbsolutePosition.X)/bar.AbsoluteSize.X,0,1); local v=minV+(maxV-minV)*p; dragging=(math.abs(v-slider.Low)<=math.abs(v-slider.High)) and "Low" or "High" end end)
            UserInputService.InputChanged:Connect(function(i) if dragging and i.UserInputType==Enum.UserInputType.MouseMovement then local p=math.clamp((i.Position.X-bar.AbsolutePosition.X)/bar.AbsoluteSize.X,0,1); local v=minV+(maxV-minV)*p; if dragging=="Low" then slider.Low=v else slider.High=v end; update(true) end end)
            UserInputService.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then dragging=nil end end)
            update(false); addControl(holder,43); return slider
        end

        function section:AddKeybind(text, defaultKeyName, callback, isMenuKey)
            local holder = new("Frame", {BackgroundTransparency=1}, body)
            local label = makeText(holder,text,13,theme.Text,Enum.Font.Gotham); label.Size=UDim2.new(1,-100,1,0)
            local button = new("TextButton", {AutoButtonColor=false, BackgroundColor3=theme.Button, BorderSizePixel=0, Text="[ "..(defaultKeyName or "None").." ]", TextColor3=theme.Text, TextSize=12, Font=Enum.Font.GothamMedium, Position=UDim2.new(1,-90,0,1), Size=UDim2.fromOffset(90,26)}, holder); corner(button,5)
            local modes = {Hold=true,Toggle=false,Always=false}; local mode="Hold"; local keyName=defaultKeyName or "None"; local listening=false; local active=false
            local kb={Key=keyName,Mode=mode,Active=false}
            local function setActive(v) active=v; kb.Active=v; callbackSafe(callback,v) end
            button.MouseButton1Click:Connect(function() listening=true; button.Text="[ ... ]" end)
            UserInputService.InputBegan:Connect(function(i,gp)
                if gp then return end
                if listening and i.UserInputType==Enum.UserInputType.Keyboard then keyName=i.KeyCode.Name; kb.Key=keyName; listening=false; button.Text="[ "..keyName.." ]"; return end
                if not isMenuKey and i.UserInputType==Enum.UserInputType.Keyboard and i.KeyCode.Name==keyName then if mode=="Hold" then setActive(true) elseif mode=="Toggle" then setActive(not active) elseif mode=="Always" then setActive(true) end end
                if isMenuKey and i.UserInputType==Enum.UserInputType.Keyboard and i.KeyCode.Name==keyName then callbackSafe(callback) end
            end)
