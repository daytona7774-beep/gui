        function section:AddButton(text, callback)
            local b = new("TextButton", {AutoButtonColor = false, BackgroundColor3 = theme.Button, BorderSizePixel = 0, Text = text, TextColor3 = theme.Text, TextSize = 13, Font = Enum.Font.GothamMedium}, body)
            corner(b, 5); stroke(b, theme.Outline, 1, 0.25)
            b.MouseButton1Click:Connect(function() callbackSafe(callback) end)
            bindHover(b, theme.Button, Color3.fromRGB(20, 43, 73))
            return addControl(b, 30)
        end

        function section:AddToggle(text, default, callback)
            local value = default == true
            local holder = new("Frame", {BackgroundTransparency = 1}, body)
            local box = new("TextButton", {AutoButtonColor = false, BackgroundColor3 = theme.Button, BorderSizePixel = 0, Text = "", Size = UDim2.fromOffset(24, 24)}, holder)
            corner(box, 5); stroke(box, theme.Outline, 1)
            local check = new("Frame", {BackgroundColor3 = theme.Accent, BorderSizePixel = 0, Size = UDim2.fromOffset(12, 12), Position = UDim2.fromOffset(6, 6), Visible = value}, box); corner(check, 3)
            local label = makeText(holder, text, 13, theme.Text, Enum.Font.Gotham)
            label.Position = UDim2.fromOffset(34, 0); label.Size = UDim2.new(1, -34, 1, 0)
            local toggle = {Value = value, Frame = holder}
            function toggle:SetValue(v)
                self.Value = v == true; check.Visible = self.Value; callbackSafe(callback, self.Value)
            end
            function toggle:GetValue() return self.Value end
            box.MouseButton1Click:Connect(function() toggle:SetValue(not toggle.Value) end)
            toggle:SetValue(value)
            return addControl(holder, 26) and toggle
        end

        function section:AddTextBox(text, default, callback)
            local holder = new("Frame", {BackgroundTransparency = 1}, body)
            local label = makeText(holder, text, 12, theme.TextDark, Enum.Font.GothamMedium)
            label.Size = UDim2.new(1, 0, 0, 18)
